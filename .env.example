AWS_PROFILE=<aws-profile>
AWS_ACCOUNT_ID=<aws-account-id>
AWS_REGION=<aws-region>
PROJECT_NAME=<project-name>
TF_STATE_BUCKET=<terraform-state-bucket>

DATA_BUCKET_NAME=<globally-unique-data-bucket>
FHIR_RESOURCE_MAP_S3_KEY=config/vitals_simulator/fhir_resource_map.json
REALTIME_ALERT_EMAIL=<alert-email>

GITHUB_REPOSITORY=<github-owner>/<repository>
GITHUB_DEPLOYMENT_ENVIRONMENT=<github-environment>
GITHUB_OIDC_SUBJECT_PREFIX=repo:<github-owner>@<owner-id>/<repository>@<repository-id>
ENABLE_GITHUB_OIDC=false

FHIR_WEBHOOK_SECRET_ID=<fhir-webhook-secret-id>
FHIR_WEBHOOK_SECRET_KEY=<fhir-webhook-secret-key>

REALTIME_PATIENT_ACCESS_PRINCIPALS=arn:aws:iam::<aws-account-id>:user/<dashboard-user>

ENABLE_OPENLINEAGE_COLLECTOR=false
OPENLINEAGE_COLLECTOR_DESIRED_COUNT=1

ML_APPROVED_MODEL_VERSION=

# Set true after the first successful Glue run creates the processed Iceberg table, then render and apply.
# ENABLE_ICEBERG_TABLE_OPTIMIZERS=false

# Everything below is reference documentation. Leave these lines commented out in .env.
# Each variable is either written by a project script, set for a single command or
# injected at runtime by Terraform, so it must not be entered by hand here.

# Written to .env by scripts/infrastructure/push_images.sh after images are published.
# VITALS_SIMULATOR_IMAGE_TAG=sha-<commit>
# DBT_IMAGE_TAG=sha-<commit>
# SODA_IMAGE_TAG=sha-<commit>
# OPENLINEAGE_COLLECTOR_IMAGE_TAG=sha-<commit>

# Derived by scripts/infrastructure/project_env.sh as <project-name>/terraform.
# TF_STATE_PREFIX=<project-name>/terraform

# Deployment environment. Leave unset for development; the production file sets production.
# Each environment lives in its own AWS account with its own copy of this file (see docs/environments.md).
# DEPLOYMENT_ENVIRONMENT=development

# Optional local overrides read by project scripts.
# AWS_DEFAULT_REGION=<aws-region>
# PROJECT_ENV_FILE=<path-to-env-file>
# PYTHON_BIN=<path-to-python>
# TERRAFORM_VAR_FILE=infra/deployment.auto.tfvars.json
# TFVARS_FILE=infra/deployment.auto.tfvars.json
# LIVE_DASHBOARD_PORT=8501
# MODEL_ANALYTICS_DASHBOARD_PORT=8502
# FHIR_RESOURCE_MAP_FILE=scripts/synthea_loader/state/fhir_resource_map.json
# BLOOD_PRESSURE_MAX_LIVE_DATA_AGE_SECONDS=310
# POPULATION=10
# SEED=12345

# Set for a single command, as shown in docs/quickstart.md and docs/load-testing.md.
# Never store FHIR_WEBHOOK_SECRET in a file.
# FHIR_BASE_URL=<terraform-output-hapi_fhir_base_url>
# FHIR_WEBHOOK_URL=<terraform-output-fhir_webhook_url>
# FHIR_WEBHOOK_SECRET=<read-from-secrets-manager-at-run-time>
# VITALS_API_ENDPOINT=<terraform-output-vitals_api_endpoint>
# VITALS_WEBSOCKET_URL=<terraform-output-realtime_websocket_url>
# KINESIS_STREAM_NAME, LOAD_TEST_KINESIS_STREAM_NAME and LOAD_TEST_RESULTS_TABLE are also required by
# scripts/load_testing/realtime_load_test.py; export them from Terraform outputs.
# LOAD_TEST_KINESIS_STREAM_NAME=<terraform-output-load_test_kinesis_stream_name>
# CONFIRM_BOOTSTRAP=apply-healthcare-realtime-bootstrap
# CONFIRM_TEARDOWN=delete-healthcare-realtime-development
# CONFIRM_IAM_POLICIES=apply-healthcare-realtime-policies
# MWAA_SERVERLESS_START_DATE=<future-iso-8601-timestamp-with-timezone>

# Injected by Terraform into the Lambda functions.
# KINESIS_STREAM_NAME=<kinesis-stream-name>
# KINESIS_STREAM_ARN=<kinesis-stream-arn>
# LATEST_VITALS_TABLE=<latest-vitals-table>
# LOAD_TEST_RESULTS_TABLE=<load-test-results-table>
# CONNECTIONS_TABLE=<websocket-connections-table>
# IDEMPOTENCY_TABLE=<processed-observations-table>
# IDEMPOTENCY_TTL_SECONDS=604800
# IDEMPOTENCY_LEASE_SECONDS=60
# WEBSOCKET_ENDPOINT=<websocket-management-endpoint>
# MAX_REPLAY_ATTEMPTS=1
# REPLAY_DLQ_URL=<replay-dlq-url>
# PATIENT_ACCESS_POLICY=<json-principal-to-patient-map>
# FHIR_WEBHOOK_SECRET_CACHE_TTL_SECONDS=300

# Injected by Terraform into the FHIR setup ECS task (docs/fhir-setup-tasks.md).
# SEED_BUNDLES_S3_PREFIX=seed/synthea/fhir

# Injected by Terraform into the vitals simulator ECS task.
# FHIR_RESOURCE_MAP_S3_BUCKET=<data-bucket>
# BIDMC_CACHE_S3_BUCKET=<data-bucket>
# BIDMC_CACHE_S3_PREFIX=cache/vitals_simulator/bidmc
# BIDMC_FETCH_MAX_ATTEMPTS=5
# BIDMC_FETCH_BACKOFF_SECONDS=2
# SIMULATOR_INTERVAL_SECONDS=5
# SIMULATOR_BP_INTERVAL_SECONDS=300
# SIMULATOR_MAX_CYCLES=unlimited
# SIMULATOR_REPLAY=true
# SIMULATOR_FHIR_MAX_ATTEMPTS=2
# SIMULATOR_FHIR_RETRY_BACKOFF_SECONDS=2
# SIMULATOR_MAX_CONSECUTIVE_FAILED_CYCLES=3
# SIMULATOR_FAILURE_RATIO_THRESHOLD=0.5
# Legacy aliases, read only when the SIMULATOR_FHIR_* values are unset.
# SIMULATOR_PUBLISH_MAX_ATTEMPTS=2
# SIMULATOR_PUBLISH_RETRY_BACKOFF_SECONDS=2
# Optional: the same seed reproduces each patient's tie or no-history choice on every host and Python version.
# Planned full-window runs prefer the less frequent tagged scenario; history can override the seeded choice.
# SIMULATOR_SCENARIO_SEED=<optional-seed>

# Injected by Terraform into the dbt, ML scoring, Soda and Great Expectations ECS tasks,
# and read by the model analytics dashboard launcher.
# ATHENA_CATALOG=<athena-catalog>
# ATHENA_WORKGROUP=<athena-workgroup>
# ATHENA_SOURCE_DATABASE=<source-database>
# ATHENA_PROCESSED_TABLE=<processed-table>
# ATHENA_DBT_DATABASE=<dbt-database>
# ATHENA_ML_DATABASE=<ml-database>
# ATHENA_PREDICTIONS_PUBLISHED_TABLE=<predictions-table>
# ATHENA_RESULTS_S3_URI=s3://<data-bucket>/athena_results/
# ATHENA_OUTPUT=s3://<data-bucket>/athena_results/great_expectations/
# ATHENA_POLL_INTERVAL_SECONDS=5
# SODA_DATA_SOURCE_NAME=<soda-data-source>
# ACTIVE_PATIENT_IDS=<ten-comma-separated-patient-ids>
# DBT_STAGING_TABLE=<table-name>
# DBT_DIM_PATIENT_TABLE=<table-name>
# DBT_DIM_ENCOUNTER_TABLE=<table-name>
# DBT_DIM_PROVIDER_TABLE=<table-name>
# DBT_DIM_OBSERVATION_TYPE_TABLE=<table-name>
# DBT_DIM_DATE_TABLE=<table-name>
# DBT_FACT_OBSERVATIONS_TABLE=<table-name>
# DBT_ENCOUNTER_FEATURES_TABLE=<table-name>
# DBT_ML_TRAINING_TABLE=<table-name>
# DBT_ML_SCORING_TABLE=<table-name>
# DBT_ML_PREDICTIONS_SERVING_TABLE=<table-name>
# DBT_ML_PREDICTIONS_LATEST_TABLE=<table-name>

# Set by Terraform for the Airflow DAG and the MWAA Serverless workflow generator.
# RAW_BUCKET=<data-bucket>
# RAW_PREFIX=raw/fhir_observations/
# GLUE_JOB_NAME=<glue-job-name>
# DATA_JOBS_ECS_CLUSTER=<ecs-cluster-name>
# DBT_ECS_TASK_DEFINITION=<task-definition-family>
# SODA_ECS_TASK_DEFINITION=<task-definition-family>
# AIRFLOW__DBT__ECS_SECURITY_GROUP=<security-group-id>
# AIRFLOW__DBT__ECS_SUBNETS=<comma-separated-subnet-ids>
# AIRFLOW__SODA__ECS_SECURITY_GROUP=<security-group-id>
# AIRFLOW__SODA__ECS_SUBNETS=<comma-separated-subnet-ids>
# AIRFLOW_PIPELINE_SCHEDULE=0 2 * * *

# Set by Git and pre-commit while the commit checks run.
# GIT_EDITOR=<editor-command>
# PRE_COMMIT_FROM_REF=<git-revision>
# PRE_COMMIT_TO_REF=<git-revision>

# OpenLineage transport. OPENLINEAGE_URL is generated by Terraform; leave it unset
# to store events in S3.
# OPENLINEAGE_URL=<collector-base-url>
# OPENLINEAGE_ENDPOINT=api/v1/lineage
# OPENLINEAGE_AWS_REGION=<aws-region>
# Optional externally managed collector, used only when ENABLE_OPENLINEAGE_COLLECTOR=false (see docs/deployment.md).
# EXTERNAL_OPENLINEAGE_COLLECTOR_URL=<https-base-url>
