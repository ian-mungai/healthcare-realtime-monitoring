AWS_PROFILE=<aws-profile>
AWS_ACCOUNT_ID=<aws-account-id>
AWS_REGION=<aws-region>
TF_STATE_REGION=
PROJECT_NAME=<project-name>
TF_STATE_BUCKET=<terraform-state-bucket>

DATA_BUCKET_NAME=<globally-unique-data-bucket>
MWAA_SOURCE_BUCKET_NAME=<globally-unique-mwaa-source-bucket>
REALTIME_ALERT_EMAIL=<alert-email>

GITHUB_REPOSITORY=<github-owner>/<repository>
GITHUB_DEPLOYMENT_ENVIRONMENT=<github-environment>
GITHUB_OIDC_SUBJECT_PREFIX=repo:<github-owner>@<owner-id>/<repository>@<repository-id>
ENABLE_GITHUB_OIDC=false

FHIR_WEBHOOK_SECRET_ID=<fhir-webhook-secret-id>
FHIR_WEBHOOK_SECRET_KEY=<fhir-webhook-secret-key>

PATIENT_IDS=<patient-id-1>,<patient-id-2>,<patient-id-3>,<patient-id-4>,<patient-id-5>,<patient-id-6>,<patient-id-7>,<patient-id-8>,<patient-id-9>,<patient-id-10>
REALTIME_PATIENT_ACCESS_PRINCIPALS=arn:aws:iam::<aws-account-id>:user/<dashboard-user>

ENABLE_OPENLINEAGE_COLLECTOR=false
OPENLINEAGE_COLLECTOR_DESIRED_COUNT=1
OPENLINEAGE_COLLECTOR_URL=

ML_APPROVED_MODEL_VERSION=
