healthcare_realtime:
  target: dev

  outputs:
    dev:
      type: athena
      database: awsdatacatalog
      schema: healthcare_realtime_dbt
      region_name: us-east-1
      s3_staging_dir: s3://YOUR_BUCKET/athena_results/dbt/
      s3_data_dir: s3://YOUR_BUCKET/dbt/
      s3_data_naming: schema_table_unique
      threads: 4