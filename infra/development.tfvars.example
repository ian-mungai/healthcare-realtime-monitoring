aws_region              = "<aws-region>"
project_name            = "<project-name>"
deployment_environment  = "<deployment-environment>"
data_bucket_name        = "<globally-unique-data-bucket>"
mwaa_source_bucket_name = "<globally-unique-mwaa-source-bucket>"
realtime_alert_email    = "<alert-email>"
kinesis_stream_name                  = "<vitals-stream-name>"
load_test_kinesis_stream_name        = "<load-test-stream-name>"
firehose_delivery_stream_name        = "<firehose-stream-name>"
glue_job_name                        = "<glue-job-name>"
raw_prefix                           = "<raw-fhir-prefix>"
airflow_pipeline_schedule            = "<airflow-cron-expression>"
athena_workgroup_name                = "<athena-workgroup-name>"
athena_results_s3_uri                = "s3://<project-data-bucket>/<athena-results-prefix>/"
source_database_name                 = "<source-database>"
processed_observations_table_name    = "<processed-observations-table>"
quarantine_table_name                = "<quarantine-table>"
dbt_database_name                    = "<dbt-database>"
ml_database_name                     = "<ml-database>"
ml_predictions_published_table_name  = "<published-predictions-table>"
athena_catalog_name                  = "<athena-catalog-name>"
soda_data_source_name                = "<soda-data-source-name>"
dbt_staging_table_name               = "<dbt-staging-table>"
dbt_dim_patient_table_name           = "<dbt-patient-dimension-table>"
dbt_dim_encounter_table_name         = "<dbt-encounter-dimension-table>"
dbt_dim_provider_table_name          = "<dbt-provider-dimension-table>"
dbt_dim_observation_type_table_name  = "<dbt-observation-type-dimension-table>"
dbt_dim_date_table_name              = "<dbt-date-dimension-table>"
dbt_fact_observations_table_name     = "<dbt-observation-fact-table>"
dbt_encounter_features_table_name    = "<dbt-encounter-features-table>"
dbt_ml_training_table_name           = "<dbt-ml-training-table>"
dbt_ml_scoring_table_name            = "<dbt-ml-scoring-table>"
dbt_ml_predictions_serving_table_name = "<dbt-ml-predictions-serving-table>"
dbt_ml_predictions_latest_table_name  = "<dbt-ml-predictions-latest-table>"
latest_vitals_table_name             = "<latest-vitals-table>"
processed_observations_state_table_name = "<processed-observations-state-table>"
load_test_results_table_name         = "<load-test-results-table>"
websocket_connections_table_name     = "<websocket-connections-table>"
api_stage_name                       = "<api-stage-name>"
fhir_webhook_secret_id               = "<fhir-webhook-secret-id>"
# Keep false for normal deployment. The teardown workflow supplies true only
# while preparing and executing an explicitly confirmed full teardown.
allow_destructive_teardown = false
hapi_skip_final_snapshot = true
openlineage_skip_final_snapshot = false
openlineage_final_snapshot_identifier = "healthcare-realtime-marquez-final"
# Bootstrap with the managed collector disabled, push its image, then enable it.
enable_openlineage_collector    = false
openlineage_collector_image_tag = "sha-<commit>"
openlineage_collector_desired_count = 1
# Leave empty when using the managed collector. Set only for an external collector.
openlineage_collector_url = ""

# Bootstrap this locally once, then use the role output as the protected GitHub
# environment variable AWS_DEPLOY_ROLE_ARN. Keep real policy ARNs in the ignored tfvars.
enable_github_oidc           = false
github_repository            = "<github-owner>/<repository>"
github_oidc_subject_prefix   = "repo:<github-owner>@<owner-id>/<repository>@<repository-id>"
github_deployment_environment = "<github-environment>"
github_deployment_policy_arns = [
  "arn:aws:iam::<aws-account-id>:policy/healthcare_realtime_apigateway_policy",
  "arn:aws:iam::<aws-account-id>:policy/healthcare_realtime_cloudformation_policy",
  "arn:aws:iam::<aws-account-id>:policy/healthcare_realtime_cloudwatch_policy",
  "arn:aws:iam::<aws-account-id>:policy/healthcare_realtime_dynamodb_policy",
  "arn:aws:iam::<aws-account-id>:policy/healthcare_realtime_ec2_policy",
  "arn:aws:iam::<aws-account-id>:policy/healthcare_realtime_ecr_policy",
  "arn:aws:iam::<aws-account-id>:policy/healthcare_realtime_ecs_policy",
  "arn:aws:iam::<aws-account-id>:policy/healthcare_realtime_elasticloadbalancing_policy",
  "arn:aws:iam::<aws-account-id>:policy/healthcare_realtime_firehose_policy",
  "arn:aws:iam::<aws-account-id>:policy/healthcare_realtime_glue_policy",
  "arn:aws:iam::<aws-account-id>:policy/healthcare_realtime_iam_policy",
  "arn:aws:iam::<aws-account-id>:policy/healthcare_realtime_kinesis_policy",
  "arn:aws:iam::<aws-account-id>:policy/healthcare_realtime_kms_policy",
  "arn:aws:iam::<aws-account-id>:policy/healthcare_realtime_lambda_policy",
  "arn:aws:iam::<aws-account-id>:policy/healthcare_realtime_logs_policy",
  "arn:aws:iam::<aws-account-id>:policy/healthcare_realtime_mwaa_policy",
  "arn:aws:iam::<aws-account-id>:policy/healthcare_realtime_rds_policy",
  "arn:aws:iam::<aws-account-id>:policy/healthcare_realtime_s3_policy",
  "arn:aws:iam::<aws-account-id>:policy/healthcare_realtime_sns_policy",
  "arn:aws:iam::<aws-account-id>:policy/healthcare_realtime_sqs_policy",
]

# Keep real account IDs and identity names only in the ignored development.tfvars file.
realtime_patient_access_policy = {
  "arn:aws:iam::<aws-account-id>:user/<dashboard-user>"      = ["<patient-id-1>", "<patient-id-2>"]
  "arn:aws:sts::<aws-account-id>:assumed-role/<role-name>/*" = ["<patient-id-1>", "<patient-id-2>", "load_test_patient_*"]
}

# Use immutable image tags produced by this repository's image build workflow.
vitals_simulator_image_tag = "sha-<commit>-<variant>"
dbt_image_tag              = "<dbt-image-tag>"
soda_image_tag             = "<soda-image-tag>"
ml_approved_model_version  = ""
