{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeHealthcareRealtimeRdsResources",
      "Effect": "Allow",
      "Action": [
        "rds:DescribeDBInstances",
        "rds:DescribeDBSubnetGroups",
        "rds:DescribeDBEngineVersions",
        "rds:DescribeOrderableDBInstanceOptions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CreateHealthcareRealtimeDatabases",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBInstance"
      ],
      "Resource": [
        "arn:aws:rds:${AWS_REGION}:${AWS_ACCOUNT_ID}:db:healthcare-realtime-hapi",
        "arn:aws:rds:${AWS_REGION}:${AWS_ACCOUNT_ID}:db:healthcare-realtime-marquez",
        "arn:aws:rds:${AWS_REGION}:${AWS_ACCOUNT_ID}:subgrp:healthcare-realtime-hapi",
        "arn:aws:rds:${AWS_REGION}:${AWS_ACCOUNT_ID}:subgrp:healthcare-realtime-marquez",
        "arn:aws:rds:${AWS_REGION}:${AWS_ACCOUNT_ID}:pg:default.postgres16"
      ]
    },
    {
      "Sid": "ManageHealthcareRealtimeDatabases",
      "Effect": "Allow",
      "Action": [
        "rds:ModifyDBInstance",
        "rds:DeleteDBInstance",
        "rds:AddTagsToResource",
        "rds:RemoveTagsFromResource",
        "rds:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:rds:${AWS_REGION}:${AWS_ACCOUNT_ID}:db:healthcare-realtime-hapi",
        "arn:aws:rds:${AWS_REGION}:${AWS_ACCOUNT_ID}:db:healthcare-realtime-marquez"
      ]
    },
    {
      "Sid": "ManageMarquezDatabaseRuntime",
      "Effect": "Allow",
      "Action": [
        "rds:StartDBInstance",
        "rds:StopDBInstance"
      ],
      "Resource": "arn:aws:rds:${AWS_REGION}:${AWS_ACCOUNT_ID}:db:healthcare-realtime-marquez"
    },
    {
      "Sid": "ManageHealthcareRealtimeDbSubnetGroups",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBSubnetGroup",
        "rds:ModifyDBSubnetGroup",
        "rds:DeleteDBSubnetGroup",
        "rds:AddTagsToResource",
        "rds:RemoveTagsFromResource",
        "rds:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:rds:${AWS_REGION}:${AWS_ACCOUNT_ID}:subgrp:healthcare-realtime-hapi",
        "arn:aws:rds:${AWS_REGION}:${AWS_ACCOUNT_ID}:subgrp:healthcare-realtime-marquez"
      ]
    }
  ]
}
