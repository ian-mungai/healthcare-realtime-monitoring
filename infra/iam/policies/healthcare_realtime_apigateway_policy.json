{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageHealthcareRealtimeApiGatewayResources",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:POST",
        "apigateway:PUT",
        "apigateway:PATCH",
        "apigateway:DELETE"
      ],
      "Resource": [
        "arn:aws:apigateway:${AWS_REGION}::/apis",
        "arn:aws:apigateway:${AWS_REGION}::/apis/*",
        "arn:aws:apigateway:${AWS_REGION}::/tags/*"
      ]
    },
    {
      "Sid": "InvokeHealthcareRealtimeApis",
      "Effect": "Allow",
      "Action": [
        "execute-api:Invoke"
      ],
      "Resource": [
        "arn:aws:execute-api:${AWS_REGION}:${AWS_ACCOUNT_ID}:*/development/GET/patients/*/vitals",
        "arn:aws:execute-api:${AWS_REGION}:${AWS_ACCOUNT_ID}:*/development/$connect"
      ]
    }
  ]
}