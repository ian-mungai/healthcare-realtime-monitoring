{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageHealthcareRealtimeApiGatewayResources",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:POST",
        "apigateway:PUT",
        "apigateway:PATCH",
        "apigateway:DELETE"
      ],
      "Resource": [
        "arn:aws:apigateway:us-east-1::/apis",
        "arn:aws:apigateway:us-east-1::/apis/*",
        "arn:aws:apigateway:us-east-1::/tags/*"
      ]
    },
    {
      "Sid": "InvokeHealthcareRealtimeApis",
      "Effect": "Allow",
      "Action": [
        "execute-api:Invoke"
      ],
      "Resource": [
        "arn:aws:execute-api:us-east-1:${AWS_ACCOUNT_ID}:*/development/GET/patients/*/vitals",
        "arn:aws:execute-api:us-east-1:${AWS_ACCOUNT_ID}:*/development/$connect"
      ]
    }
  ]
}