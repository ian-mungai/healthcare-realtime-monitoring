{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectHealthcareRealtimeDeveloperIdentity",
      "Effect": "Allow",
      "Action": [
        "iam:GetUser",
        "iam:GetUserPolicy",
        "iam:ListAttachedUserPolicies",
        "iam:ListUserPolicies",
        "iam:ListGroupsForUser"
      ],
      "Resource": "arn:aws:iam::${AWS_ACCOUNT_ID}:user/healthcare_realtime_dev"
    },
    {
      "Sid": "InspectIamManagedPoliciesAndGroups",
      "Effect": "Allow",
      "Action": [
        "iam:GetGroupPolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListAttachedGroupPolicies",
        "iam:ListGroupPolicies",
        "iam:ListPolicies",
        "iam:ListPolicyVersions",
        "iam:ListEntitiesForPolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ListHealthcareRealtimeGroups",
      "Effect": "Allow",
      "Action": [
        "iam:ListGroups"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageHealthcareRealtimeDeveloperGroups",
      "Effect": "Allow",
      "Action": [
        "iam:CreateGroup",
        "iam:DeleteGroup",
        "iam:GetGroup",
        "iam:AddUserToGroup",
        "iam:RemoveUserFromGroup",
        "iam:ListAttachedGroupPolicies",
        "iam:ListGroupPolicies"
      ],
      "Resource": [
        "arn:aws:iam::${AWS_ACCOUNT_ID}:group/healthcare_realtime_data_group",
        "arn:aws:iam::${AWS_ACCOUNT_ID}:group/healthcare_realtime_compute_group",
        "arn:aws:iam::${AWS_ACCOUNT_ID}:group/healthcare_realtime_platform_group"
      ]
    },
    {
      "Sid": "ManageHealthcareRealtimeGroupPolicyAttachments",
      "Effect": "Allow",
      "Action": [
        "iam:AttachGroupPolicy",
        "iam:DetachGroupPolicy"
      ],
      "Resource": [
        "arn:aws:iam::${AWS_ACCOUNT_ID}:group/healthcare_realtime_data_group",
        "arn:aws:iam::${AWS_ACCOUNT_ID}:group/healthcare_realtime_compute_group",
        "arn:aws:iam::${AWS_ACCOUNT_ID}:group/healthcare_realtime_platform_group"
      ],
      "Condition": {
        "ArnLike": {
          "iam:PolicyARN": "arn:aws:iam::${AWS_ACCOUNT_ID}:policy/healthcare_realtime_*"
        }
      }
    },
    {
      "Sid": "ManageHealthcareRealtimeDeveloperPolicyAttachments",
      "Effect": "Allow",
      "Action": [
        "iam:AttachUserPolicy",
        "iam:DetachUserPolicy"
      ],
      "Resource": "arn:aws:iam::${AWS_ACCOUNT_ID}:user/healthcare_realtime_dev",
      "Condition": {
        "ArnLike": {
          "iam:PolicyARN": "arn:aws:iam::${AWS_ACCOUNT_ID}:policy/healthcare_realtime_*"
        }
      }
    },
    {
      "Sid": "SimulateHealthcareRealtimeDeveloperPolicy",
      "Effect": "Allow",
      "Action": [
        "iam:SimulatePrincipalPolicy"
      ],
      "Resource": "arn:aws:iam::${AWS_ACCOUNT_ID}:user/healthcare_realtime_dev"
    },
    {
      "Sid": "ListHealthcareRealtimeRoles",
      "Effect": "Allow",
      "Action": [
        "iam:ListRoles"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageHealthcareRealtimeRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:ListRoleTags"
      ],
      "Resource": [
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/healthcare_realtime_*",
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/healthcare-realtime-*"
      ]
    },
    {
      "Sid": "ManageHealthcareRealtimeManagedPolicyVersions",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion"
      ],
      "Resource": "arn:aws:iam::${AWS_ACCOUNT_ID}:policy/healthcare_realtime_*"
    },
    {
      "Sid": "CreateHealthcareRealtimeManagedPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassHealthcareRealtimeRolesToProjectServices",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/healthcare_realtime_*",
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/healthcare-realtime-*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "lambda.amazonaws.com",
            "firehose.amazonaws.com",
            "glue.amazonaws.com",
            "airflow.amazonaws.com",
            "ecs-tasks.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "SimulateHealthcareRealtimeRoles",
      "Effect": "Allow",
      "Action": [
        "iam:SimulatePrincipalPolicy"
      ],
      "Resource": [
        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/healthcare_realtime_*"
      ]
    }
  ]
}
