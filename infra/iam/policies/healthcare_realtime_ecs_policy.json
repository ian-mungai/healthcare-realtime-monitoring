{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListHealthcareRealtimeEcsResources",
      "Effect": "Allow",
      "Action": [
        "ecs:ListClusters"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageHealthcareRealtimeClusters",
      "Effect": "Allow",
      "Action": [
        "ecs:CreateCluster",
        "ecs:DeleteCluster",
        "ecs:DescribeClusters",
        "ecs:UpdateCluster",
        "ecs:UpdateClusterSettings",
        "ecs:ListTagsForResource",
        "ecs:TagResource",
        "ecs:UntagResource"
      ],
      "Resource": [
        "arn:aws:ecs:${AWS_REGION}:${AWS_ACCOUNT_ID}:cluster/healthcare-realtime-data-jobs",
        "arn:aws:ecs:${AWS_REGION}:${AWS_ACCOUNT_ID}:cluster/healthcare-realtime-services"
      ]
    },
    {
      "Sid": "ManageHealthcareRealtimeServices",
      "Effect": "Allow",
      "Action": [
        "ecs:CreateService",
        "ecs:UpdateService",
        "ecs:DeleteService",
        "ecs:DescribeServices",
        "ecs:ListServices",
        "ecs:TagResource",
        "ecs:UntagResource"
      ],
      "Resource": [
        "arn:aws:ecs:${AWS_REGION}:${AWS_ACCOUNT_ID}:service/healthcare-realtime-data-jobs/*",
        "arn:aws:ecs:${AWS_REGION}:${AWS_ACCOUNT_ID}:service/healthcare-realtime-services/*"
      ]
    },
    {
      "Sid": "ManageHealthcareRealtimeDataJobTaskDefinitions",
      "Effect": "Allow",
      "Action": [
        "ecs:RegisterTaskDefinition",
        "ecs:DeregisterTaskDefinition",
        "ecs:DescribeTaskDefinition",
        "ecs:ListTaskDefinitions",
        "ecs:ListTaskDefinitionFamilies",
        "ecs:TagResource",
        "ecs:UntagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RunHealthcareRealtimeTasks",
      "Effect": "Allow",
      "Action": [
        "ecs:RunTask",
        "ecs:DescribeTasks",
        "ecs:StopTask",
        "ecs:ListTasks"
      ],
      "Resource": "*"
    }
  ]
}
