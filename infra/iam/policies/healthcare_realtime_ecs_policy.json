{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageHealthcareRealtimeDataJobsCluster",
      "Effect": "Allow",
      "Action": [
        "ecs:CreateCluster",
        "ecs:DeleteCluster",
        "ecs:DescribeClusters",
        "ecs:UpdateCluster",
        "ecs:UpdateClusterSettings",
        "ecs:ListTagsForResource",
        "ecs:TagResource",
        "ecs:UntagResource"
      ],
      "Resource": "arn:aws:ecs:us-east-1:${AWS_ACCOUNT_ID}:cluster/healthcare-realtime-data-jobs"
    },
    {
      "Sid": "ManageHealthcareRealtimeDataJobTaskDefinitions",
      "Effect": "Allow",
      "Action": [
        "ecs:RegisterTaskDefinition",
        "ecs:DeregisterTaskDefinition",
        "ecs:DescribeTaskDefinition",
        "ecs:ListTaskDefinitions",
        "ecs:ListTaskDefinitionFamilies",
        "ecs:TagResource",
        "ecs:UntagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RunHealthcareRealtimeDataJobs",
      "Effect": "Allow",
      "Action": [
        "ecs:RunTask",
        "ecs:DescribeTasks",
        "ecs:StopTask",
        "ecs:ListTasks"
      ],
      "Resource": "*"
    }
  ]
}
