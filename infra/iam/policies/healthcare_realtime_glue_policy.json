{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadHealthcareGlueResources",
      "Effect": "Allow",
      "Action": [
        "glue:GetDatabase",
        "glue:GetDatabases",
        "glue:GetTable",
        "glue:GetTables",
        "glue:GetTableVersion",
        "glue:GetTableVersions",
        "glue:GetPartition",
        "glue:GetPartitions",
        "glue:BatchGetPartition",
        "glue:GetJob",
        "glue:GetJobs",
        "glue:GetJobRun",
        "glue:GetJobRuns",
        "glue:GetTags"
      ],
      "Resource": [
        "arn:aws:glue:${AWS_REGION}:${AWS_ACCOUNT_ID}:catalog",
        "arn:aws:glue:${AWS_REGION}:${AWS_ACCOUNT_ID}:database/${SOURCE_DATABASE_NAME}",
        "arn:aws:glue:${AWS_REGION}:${AWS_ACCOUNT_ID}:database/${DBT_DATABASE_NAME}",
        "arn:aws:glue:${AWS_REGION}:${AWS_ACCOUNT_ID}:table/${SOURCE_DATABASE_NAME}/*",
        "arn:aws:glue:${AWS_REGION}:${AWS_ACCOUNT_ID}:table/${DBT_DATABASE_NAME}/*",
        "arn:aws:glue:${AWS_REGION}:${AWS_ACCOUNT_ID}:job/${GLUE_JOB_NAME}"
      ]
    },
    {
      "Sid": "ManageHealthcareRealtimeGlueJob",
      "Effect": "Allow",
      "Action": [
        "glue:CreateJob",
        "glue:UpdateJob",
        "glue:DeleteJob",
        "glue:StartJobRun"
      ],
      "Resource": "arn:aws:glue:${AWS_REGION}:${AWS_ACCOUNT_ID}:job/${GLUE_JOB_NAME}"
    },
    {
      "Sid": "ManageHealthcareGlueCatalog",
      "Effect": "Allow",
      "Action": [
        "glue:CreateDatabase",
        "glue:GetDatabase",
        "glue:GetDatabases",
        "glue:GetTags",
        "glue:TagResource",
        "glue:UntagResource",
        "glue:DeleteDatabase",
        "glue:GetTable",
        "glue:GetTables",
        "glue:CreateTable",
        "glue:UpdateTable",
        "glue:DeleteTable"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageDbtGlueCatalogObjects",
      "Effect": "Allow",
      "Action": [
        "glue:CreateTable",
        "glue:UpdateTable",
        "glue:DeleteTable",
        "glue:BatchDeleteTable",
        "glue:DeleteTableVersion",
        "glue:BatchDeleteTableVersion"
      ],
      "Resource": [
        "arn:aws:glue:${AWS_REGION}:${AWS_ACCOUNT_ID}:catalog",
        "arn:aws:glue:${AWS_REGION}:${AWS_ACCOUNT_ID}:database/${DBT_DATABASE_NAME}",
        "arn:aws:glue:${AWS_REGION}:${AWS_ACCOUNT_ID}:database/${ML_DATABASE_NAME}",
        "arn:aws:glue:${AWS_REGION}:${AWS_ACCOUNT_ID}:table/${DBT_DATABASE_NAME}/*",
        "arn:aws:glue:${AWS_REGION}:${AWS_ACCOUNT_ID}:table/${ML_DATABASE_NAME}/*"
      ]
    },
    {
      "Sid": "ManageHealthcareGluePartitions",
      "Effect": "Allow",
      "Action": [
        "glue:CreatePartition",
        "glue:BatchCreatePartition",
        "glue:UpdatePartition",
        "glue:DeletePartition",
        "glue:BatchDeletePartition"
      ],
      "Resource": "*"
    }
  ]
}
