{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunHealthcareAthenaQueries",
      "Effect": "Allow",
      "Action": [
        "athena:StartQueryExecution",
        "athena:GetQueryExecution",
        "athena:GetQueryResults",
        "athena:StopQueryExecution",
        "athena:ListQueryExecutions"
      ],
      "Resource": [
        "arn:aws:athena:${AWS_REGION}:${AWS_ACCOUNT_ID}:workgroup/${ATHENA_WORKGROUP_NAME}"
      ]
    },
    {
      "Sid": "ReadHealthcareAthenaMetadata",
      "Effect": "Allow",
      "Action": [
        "athena:GetDatabase",
        "athena:GetTableMetadata",
        "athena:ListDatabases",
        "athena:ListTableMetadata"
      ],
      "Resource": [
        "arn:aws:athena:${AWS_REGION}:${AWS_ACCOUNT_ID}:datacatalog/${ATHENA_CATALOG_NAME}",
        "arn:aws:athena:${AWS_REGION}:${AWS_ACCOUNT_ID}:datacatalog/AwsDataCatalog"
      ]
    }
  ]
}
