// Markdown syntax baseline.
{
  "config": {
    "default": true,
    "MD013": false,                              // No fixed line-length limit
    "MD024": { "siblings_only": true },          // Repeated subheadings under different parents, as in Keep a Changelog releases
    "MD025": { "front_matter_title": "" },        // Allow YAML title plus H1; equality needs a separate check
    "MD003": { "style": "atx" },
    "MD004": { "style": "dash" },                // Unordered lists use dash markers
    "MD029": { "style": "ordered" },             // Sequential numbers, citable by item
    "MD033": { "allowed_elements": ["details", "summary"] }, // GitHub supports collapsed historical context
    "MD040": true,                               // Fence language is specified
    "MD045": true                                // Alt text exists; quality needs review
  }
}
